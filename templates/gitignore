# Merge these into the repo's .gitignore (add language-appropriate lines).

# Secrets & token caches (NEVER commit)
.env
.cache/

# Claude Code machine-local settings
.claude/settings.local.json

# Local data lives outside the repo, in this project's folder in the machine-level data home
# (CLAUDE.md's data ground rule: data only; code and docs stay here, the data layout doc
# included). This line is the safety net: a data/ written here by mistake, or the fallback
# home when there is no data home, is never committed. Drop it when the repo already tracks
# files under data/. Anchored to the root, so a nested data/ (a package's data,
# tests/fixtures/data/) stays tracked. Synthetic test fixtures live in the repo (e.g.
# tests/fixtures/), never in the data home, so tests run on any machine.
/data/

# Rebuildable artifacts (the script is the artifact — outputs stay untracked)
# {{ARTIFACT_DIRS}}   e.g. outputs/, *.duckdb

